<%- include('../partials/header')  %>

<h2>Ajánlataink</h2>
<p>Áraink forintban értendők és az ÁFA-t tartalmazzák.</p>

<table>
    <thead>
        <tr>
            <th>Megnevezés</th>
            <th>Tartalom</th>
            <th>Egységár</th>
        </tr>
    </thead>
    <tbody>
    <% for (const srv of services) { %>
        <tr>
            <td><%= srv.name %></td>
            <td><%= srv.description %></td>
            <td><%= srv.price %> HUF</td>
        </tr>
    <% } %>    
    </tbody>
</table>

<%- include('../partials/footer') %>